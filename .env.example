# ── GhostMate configuration ───────────────────────────────────────────────
# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# development | production
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Include a database name, e.g. .../ghostmate?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ghostmate?retryWrites=true&w=majority
# Local alternative: MONGODB_URI=mongodb://localhost:27017/ghostmate

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Origin(s) of the frontend in development (comma separated).
CLIENT_ORIGIN=http://localhost:5173

# The first account can always be created. Set to true to allow more accounts afterwards.
ALLOW_REGISTRATION=false

# ── AI ────────────────────────────────────────────────────────────────────
# anthropic = real Claude API (default)
# mock      = clearly labelled development placeholders, no API key needed
# none      = AI features disabled; everything else works
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model id from https://platform.claude.com/docs/en/about-claude/models/overview
# claude-opus-5-5 is the most capable; claude-sonnet-5-5 or claude-haiku-5-5 cost less.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (lower = cheaper and faster)
ANTHROPIC_EFFORT=medium
# default = if the model declines a request for policy reasons, Anthropic retries it on a fallback model; off = disable
ANTHROPIC_FALLBACKS=default

# Agent safety limits per chat message
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=12

# Uploads and reminders
MAX_UPLOAD_MB=20
REMINDER_POLL_SECONDS=30
